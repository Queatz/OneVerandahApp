# =============================================================================
# One Verandah – Dynamic Image Generation backend configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` (next to the running JAR, or the project root in dev)
# and fill in the values you need. Every optional integration degrades
# gracefully: with an empty `.env` the server still runs end-to-end using
# in-memory storage, local file image storage and an offline placeholder
# image generator.
#
# Precedence: real process environment variables override values in `.env`.
# =============================================================================

# --- Runtime environment ------------------------------------------------------
# development | production. Production defaults SSL_ENABLED to true.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=7071

# Public base URL used to build local image URLs (e.g. http://localhost:7071).
# Leave blank to auto-derive from host/port/scheme.
PUBLIC_BASE_URL=

# Comma-separated list of allowed CORS origins (hostnames, no scheme).
# Leave blank to allow any origin (convenient in development).
CORS_ALLOWED_HOSTS=

# --- SSL / HTTPS (production) -------------------------------------------------
# When enabled, an extra HTTPS connector is added on SSL_PORT using the given
# Java keystore (JKS or PKCS12). In development you normally terminate TLS at
# nginx instead (see DEPLOY.md) and leave this disabled.
SSL_ENABLED=false
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=
SSL_KEY_ALIAS=oneverandah
SSL_PRIVATE_KEY_PASSWORD=
SSL_PORT=8443

# --- ArangoDB (optional; falls back to in-memory) -----------------------------
# Set ARANGO_HOST to enable persistence. The app provisions the database,
# collection and indexes automatically on startup.
ARANGO_HOST=
ARANGO_PORT=8529
ARANGO_DB=image_generator
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_SSL=false

# --- Alibaba OSS (optional; falls back to local disk storage) -----------------
# All four of ENDPOINT / ACCESS_KEY_ID / ACCESS_KEY_SECRET / BUCKET_NAME are
# required to enable OSS uploads.
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_REGION=cn-hangzhou
# Optional CDN / custom-domain base for public URLs (defaults to the bucket URL).
OSS_PUBLIC_BASE_URL=

# --- Qwen / DashScope (optional; falls back to offline placeholder generator) -
QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
QWEN_API_KEY=
QWEN_MODEL=wanx2.1-t2i-turbo

# --- Generation tuning --------------------------------------------------------
# Directory that backs local storage (relative to the working directory).
LOCAL_STORAGE_DIR=data/images
MAX_CONCURRENT_GENERATIONS=2
GENERATION_DELAY_MS=1000
GENERATION_MAX_RETRIES=3
# How often (ms) to re-queue FAILED images. 3600000 = 1 hour.
RESCHEDULE_INTERVAL_MS=3600000
# Seed the catalog and start the generation worker on startup.
IMAGE_AUTOSTART=true
