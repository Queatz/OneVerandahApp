# =============================================================================
# One Verandah – Dynamic Image Generation backend configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` (next to the running JAR, or the project root in dev)
# and fill in the values you need. Every optional integration degrades
# gracefully: with an empty `.env` the server still runs end-to-end using
# in-memory storage, local file image storage and an offline placeholder
# image generator.
#
# Precedence: real process environment variables override values in `.env`.
# =============================================================================

# --- Runtime environment ------------------------------------------------------
# development | production. Production defaults SSL_ENABLED to true.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=7071

# Public base URL used to build local image URLs (e.g. http://localhost:7071).
# Leave blank to auto-derive from host/port/scheme.
PUBLIC_BASE_URL=

# Comma-separated list of allowed CORS origins (hostnames, no scheme).
# Leave blank to allow any origin (convenient in development).
CORS_ALLOWED_HOSTS=

# --- SSL / HTTPS (production) -------------------------------------------------
# When enabled, an extra HTTPS connector is added on SSL_PORT using the given
# Java keystore (JKS or PKCS12). In development you normally terminate TLS at
# nginx instead (see DEPLOY.md) and leave this disabled.
SSL_ENABLED=false
# Public domain the server is reached at (the hostname its certificate is
# issued for, e.g. api.oneverandah.app). When PUBLIC_BASE_URL is blank this is
# used to build public image URLs, so they never fall back to "localhost" in
# production. deploy.sh sets this automatically from SSL_DOMAIN.
SSL_DOMAIN=
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=
SSL_KEY_ALIAS=oneverandah
SSL_PRIVATE_KEY_PASSWORD=
SSL_PORT=8443

# --- ArangoDB (optional; falls back to in-memory) -----------------------------
# Set ARANGO_HOST to enable persistence. The app provisions the database,
# collection and indexes automatically on startup.
ARANGO_HOST=
ARANGO_PORT=8529
ARANGO_DB=image_generator
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_SSL=false

# --- Alibaba OSS (optional; falls back to local disk storage) -----------------
# All four of ENDPOINT / ACCESS_KEY_ID / ACCESS_KEY_SECRET / BUCKET_NAME are
# required to enable OSS uploads. Leave any blank to store images on local disk
# (served at /images/...).
#
# NOTE: Since 2025-03-20, mainland-China buckets (cn-*) reject the default public
# `*.aliyuncs.com` endpoint for uploads/downloads (`PublicEndpointForbidden`).
# For those buckets, bind a custom domain (CNAME) to the bucket and set
# OSS_ENDPOINT to that domain with OSS_CNAME=true (or use an internal /
# transfer-acceleration endpoint).
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_REGION=cn-hangzhou
# Treat OSS_ENDPOINT as a custom domain (CNAME) bound to the bucket instead of
# the virtual-hosted `bucket.endpoint` form. Required for China-region buckets.
OSS_CNAME=false
# Optional CDN / custom-domain base for public URLs (defaults to the bucket URL).
OSS_PUBLIC_BASE_URL=

# --- Qwen / DashScope (optional; falls back to offline placeholder generator) -
# QWEN_MODEL / QWEN_R2I_MODEL default to qwen-image-3.0-pro. Text-only calls are
# auto-routed to multimodal-generation even when QWEN_API_ENDPOINT still points
# at classic text2image/image-synthesis (that pairing otherwise returns
# InvalidParameter "url error").
QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
QWEN_API_KEY=
QWEN_MODEL=qwen-image-3.0-pro
# Multimodal still images (text-only qwen-image / wan2.x-image + reference-grounded R2I).
# Local reference photo URLs are automatically re-hosted to DashScope temporary
# OSS before the model call.
QWEN_R2I_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_R2I_MODEL=qwen-image-3.0-pro
# Speed: skip LLM prompt rewrite (~3-4s/image). Multimodal size floor is ~768*768.
QWEN_PROMPT_EXTEND=false
QWEN_T2I_SIZE=512*512
QWEN_R2I_SIZE=512*512
QWEN_MULTIMODAL_SIZE=768*768
# Speech synthesis (Qwen-Audio-TTS). Endpoint is fixed to Beijing WebSocket.
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
# Default designed system voice for qwen-audio-3.0-tts-flash.
QWEN_TTS_VOICE=longanhuan_v3.6
# Required for realtime voice input. This is the Beijing Model Studio workspace
# ID used to build wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime.
QWEN_ASR_WORKSPACE_ID=
# Optional full endpoint override for another region/workspace.
QWEN_ASR_ENDPOINT=
QWEN_ASR_MODEL=qwen3-asr-flash-realtime

# --- Generation tuning --------------------------------------------------------
# Directory that backs local storage (relative to the working directory).
LOCAL_STORAGE_DIR=data/images
# Directory holding a local backup of every generated image. It lets a failed
# OSS upload be retried by re-uploading the cached bytes instead of paying for
# another Qwen generation.
IMAGE_CACHE_DIR=data/image-cache
MAX_CONCURRENT_GENERATIONS=2
GENERATION_DELAY_MS=1000
GENERATION_MAX_RETRIES=3
# How often (ms) to re-queue FAILED images. 3600000 = 1 hour.
RESCHEDULE_INTERVAL_MS=3600000
# Seed the catalog and start the generation worker on startup.
IMAGE_AUTOSTART=true
# Sppechgen.io
SPEECHGEN_API_KEY=
SPEECHGEN_EMAIL=

